{
  "name": "@convex-dev/mastra",
  "description": "A mastra component for Convex.",
  "repository": "github:convex/mastra",
  "homepage": "https://github.com/convex/mastra#readme",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/mastra/issues"
  },
  "version": "0.0.1-alpha.8",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "check": "npm run test && npm run typecheck && npm run lint",
    "test:e2e": "convex init && npm run build:codegen && convex dev --once --typecheck-components"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./mapping": {
      "types": "./dist/mapping/index.d.ts",
      "default": "./dist/mapping/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@mastra/core": "^0.8.0 || ^0.24.0",
    "ai": "^4.2.0",
    "convex": "^1.31.0",
    "convex-helpers": "^0.1.100"
  },
  "devDependencies": {
    "@ai-sdk/openai": "1.3.24",
    "@convex-dev/eslint-plugin": "5.0.1",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@libsql/client": "0.18.0",
    "@mastra/core": "0.24.9",
    "@mastra/memory": "0.15.13",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ai": "4.3.19",
    "chokidar-cli": "3.0.0",
    "convex": "1.49.0",
    "convex-test": "0.0.69",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.0",
    "zod": "3.25.76"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
