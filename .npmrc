# Prevents by default all dependency versions more recent than 7 days
# from being installed.
# If necessary (e.g. to install a urgent security fix), you can override
# this using `npm install <package>@<version> --min-release-age=0`
min-release-age=7

# onnxruntime-node (via fastembed) downloads CUDA binaries on Linux x64 during
# install; that release download now 404s, and we only use the CPU runtime.
onnxruntime-node-install-cuda=skip
